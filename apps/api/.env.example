DATABASE_URL=mysql://time-capsule-app:eluspac-emit@database:3306/time-capsule
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Media storage: S3 API on RustFS (compose services `storage` + `storage-init`).
# S3_ENDPOINT is what the api reaches; S3_PUBLIC_ENDPOINT is what the browser reaches (the port
# is bound to 127.0.0.1 on the host). Presigned URLs only work on the host they were signed for.
# The keys must equal RUSTFS_ACCESS_KEY / RUSTFS_SECRET_KEY in compose.yml (dev-only values).
S3_ENDPOINT=http://storage:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=time-capsule-media
S3_ACCESS_KEY_ID=time-capsule-app
S3_SECRET_ACCESS_KEY=time-capsule-dev-secret
S3_FORCE_PATH_STYLE=true
