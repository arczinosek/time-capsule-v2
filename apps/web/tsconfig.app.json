{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Resolve @time-capsule/shared to its TS source (see packages/shared/package.json exports).
    "customConditions": ["@time-capsule/source"],
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "paths": { "~/*": ["./src/*"] }
  },
  "include": ["src"],
  // Specs and test helpers are type-checked by tsconfig.test.json (with test globals).
  "exclude": ["src/**/*.spec.ts", "src/**/*.spec.tsx", "src/test"]
}
