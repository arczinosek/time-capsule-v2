{
  // Type-checks specs and test helpers (tsc -b via tsconfig.json). App code never sees test globals.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "vitest/globals"]
  },
  "include": ["src/**/*.spec.ts", "src/**/*.spec.tsx", "src/test"],
  // Must override: otherwise it inherits tsconfig.app.json's exclude and checks nothing.
  "exclude": []
}
